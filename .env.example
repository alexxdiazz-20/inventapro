# Copia este archivo como ".env" y rellena tus valores reales.
# El .env NO se sube al repo (está en .gitignore).

# Base de datos (XAMPP MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventario_db

# JWT (pon una cadena larga y aleatoria, única tuya)
JWT_SECRET=cambia_esto_por_algo_largo_y_aleatorio

# Servidor
PORT=3000
NODE_ENV=development

# Stripe (saca tus claves de https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_tu_clave_aqui
STRIPE_PUBLIC_KEY=pk_test_tu_clave_aqui
